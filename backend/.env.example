# Copy this file to backend/.env and fill in real values. Never commit .env.

# PostgreSQL connection for the Tutoring_Hub_db database
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/Tutoring_Hub_db

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS - origin(s) the frontend is served from, comma-separated
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# SMTP (optional in dev - if left blank, emails are logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tutorhub-uae.com
SMTP_USE_TLS=true

# Admin email that receives general Contact page messages
ADMIN_NOTIFICATION_EMAIL=admin@tutorhub-uae.com

# Where the seed script provisions the first admin login
SEED_ADMIN_EMAIL=admin@tutorhub-uae.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Site Administrator

# Uploaded profile photos
UPLOAD_DIR=static/uploads
MAX_UPLOAD_MB=5
